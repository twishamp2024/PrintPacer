<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:PrintPacer.App.Views">

    <!-- ===== Palette =====================================================
         A cool indigo-tinted surface with one strong accent, and a hue per section
         so the page can be scanned by colour. The application is used late at night
         and left running, so the tints stay soft; strong colour is kept for the app
         bar, the one main action, and state that matters.
    -->
    <Color x:Key="AccentColor">#1D4ED8</Color>
    <Color x:Key="AccentDarkColor">#1E3A8A</Color>
    <Color x:Key="AccentVioletColor">#7C3AED</Color>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDark" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E6EDFF" />

    <!-- The main action: blue running into violet. -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2563EB" />
        <GradientStop Offset="1" Color="{StaticResource AccentVioletColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#06B6D4" />
        <GradientStop Offset="0.5" Color="#2563EB" />
        <GradientStop Offset="1" Color="{StaticResource AccentVioletColor}" />
    </LinearGradientBrush>

    <!-- The app bar across the top of the main window. -->
    <LinearGradientBrush x:Key="AppBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#1E3A8A" />
        <GradientStop Offset="0.55" Color="#3730A3" />
        <GradientStop Offset="1" Color="#6D28D9" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppBarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBarTextSoft" Color="#D5DCFF" />

    <!-- A PDF, wherever one is named on its own: the red the format is known by. -->
    <LinearGradientBrush x:Key="PdfBadge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E11D48" />
        <GradientStop Offset="1" Color="#F97316" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBackground" Color="#EEF2FB" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F3F6FD" />
    <!-- The job page behind the fields: tinted, so the white fields stand out on it. -->
    <SolidColorBrush x:Key="Page" Color="#F7F8FE" />
    <!-- The queue sidebar, and a row in it under the mouse. -->
    <SolidColorBrush x:Key="Sidebar" Color="#E9EEFB" />
    <SolidColorBrush x:Key="SidebarHover" Color="#DCE4F8" />
    <SolidColorBrush x:Key="Border" Color="#DCE2F0" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C3CCE0" />

    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5B6782" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Success" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Warning" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Waiting" Color="#0369A1" />
    <SolidColorBrush x:Key="WaitingSoft" Color="#E0F2FE" />

    <!-- One hue per section, for its heading chip. Dark enough to read on white. -->
    <SolidColorBrush x:Key="HueViolet" Color="#7C3AED" />
    <SolidColorBrush x:Key="HueAmber" Color="#D97706" />
    <SolidColorBrush x:Key="HueTeal" Color="#0D9488" />
    <SolidColorBrush x:Key="HueBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="HuePink" Color="#DB2777" />
    <SolidColorBrush x:Key="HueGreen" Color="#059669" />
    <SolidColorBrush x:Key="HueIndigo" Color="#4F46E5" />
    <SolidColorBrush x:Key="HueRed" Color="#DC2626" />
    <SolidColorBrush x:Key="HueSlate" Color="#475569" />
    <!-- The plan summary sits on the green of its heading. -->
    <SolidColorBrush x:Key="PlanSoft" Color="#ECFDF5" />
    <SolidColorBrush x:Key="PlanBorder" Color="#A7F3D0" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Typography ================================================== -->

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!--
        The hierarchy on every screen is: job title, then section heading, then field label,
        then the value. Size and weight carry it, not capitals, so only titles and section
        headings are ever bold.
    -->

    <!-- Names a group of settings: "Print settings", "Batching", "Printer". -->
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- A section heading with its tinted icon chip. Hue and Glyph are set per section. -->
    <Style TargetType="v:SectionTitle">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Hue" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="v:SectionTitle">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Grid Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="{TemplateBinding Hue}" Opacity="0.15" />
                            <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}"
                                       FontSize="12" Foreground="{TemplateBinding Hue}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Text}" Style="{StaticResource SectionHeading}" Margin="0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small, quiet label above a single field. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- A note under or beside a field: what a choice means on this printer, and so on. -->
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== Surfaces ==================================================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!--
        A group of settings on the plain page: a hairline above it and room around it, rather
        than a box of its own. The first section on a screen has no line.
    -->
    <Style x:Key="Section" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,13" />
    </Style>

    <!-- Something that must stand out a little: a warning, or files that were not added. -->
    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{StaticResource WarningSoft}" />
    </Style>

    <!-- ===== Buttons ===================================================== -->

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The one button the whole application exists for: clearly the main action, never shouting. -->
    <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,11" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="#FCA5A5" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- A link on the coloured app bar. -->
    <Style x:Key="AppBarLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Foreground" Value="{StaticResource AppBarTextSoft}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AppBarText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button on the coloured app bar: frosted glass rather than white. -->
    <Style x:Key="AppBarButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="BorderBrush" Value="#55FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource AppBarText}" />
    </Style>

    <!--
        Small borderless buttons on a queue row: move up, move down, remove. They are on every
        row, so they stay quiet until pointed at.
    -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource Border}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.3" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A link that opens or closes the panel under it: "View schedule", "How the queue works".
        The chevron turns, and screen readers hear it as a toggle.
    -->
    <Style x:Key="Disclosure" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 0 8" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" VerticalAlignment="Center" Margin="1,1,8,0"
                                  RenderTransformOrigin="0.5,0.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Queue ======================================================= -->

    <!-- Drawn when a row is reached with the keyboard, never on a mouse click. -->
    <Style x:Key="RowFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{StaticResource Accent}" StrokeThickness="1.5" RadiusX="6" RadiusY="6"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One job in the print queue: a flat row on the sidebar. The selected job is lifted onto
        the page colour with an accent bar at its edge - a shape as well as a colour, so it
        reads without colour too.
    -->
    <Style x:Key="QueueItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Padding" Value="14,10,8,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,10"
                                CornerRadius="1.5" Background="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SidebarHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Border}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ====================================================== -->

    <!--
        The content host follows the shape of the stock WPF TextBox template: a named
        ScrollViewer that is not focusable, with padding applied through the control's own
        Padding property rather than a margin on the host. Deviating from this is how a
        text box ends up drawing its border and nothing else.
    -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush"
                                    Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush"
                                    Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A flat drop-down that matches the text fields: same height, border, radius and focus
        colour, where the stock template draws a grey gradient. Only the look is replaced, so
        the keyboard works as before (arrows, F4, Alt+Down, typing the first letter).
    -->
    <Style x:Key="DropdownToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,12,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{StaticResource SurfaceMuted}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{StaticResource AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dropdown" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource DropdownToggle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter IsHitTestVisible="False" Margin="11,0,30,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Border x:Name="FocusRing" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                CornerRadius="6" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,0,6,6"
                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}"
                                    BorderThickness="1" CornerRadius="6" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12" Direction="270" />
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DateField" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="0,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Progress ==================================================== -->

    <Style x:Key="Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource ProgressGradient}" />
        <Setter Property="Background" Value="#DCE3F5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="5"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Status pill =================================================
         Used for both job state and per-batch state. Colour is carried in by
         the view model so the same template serves every status.
    -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
