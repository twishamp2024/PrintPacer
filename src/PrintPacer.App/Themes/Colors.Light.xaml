<!--
    The colours of the light theme. Colors.Dark.xaml defines the same keys; ThemeManager
    swaps one for the other at run time, which is why every view refers to these brushes
    with DynamicResource. A key added here must be added there too (a test checks).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Light palette ===============================================
         A cool indigo-tinted surface with one strong accent, and a hue per section
         so the page can be scanned by colour. The application is used late at night
         and left running, so the tints stay soft; strong colour is kept for the app
         bar, the one main action, and state that matters.
    -->
    <Color x:Key="AccentColor">#1D4ED8</Color>
    <Color x:Key="AccentDarkColor">#1E3A8A</Color>
    <Color x:Key="AccentVioletColor">#7C3AED</Color>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDark" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E6EDFF" />

    <!-- The main action: blue running into violet. -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2563EB" />
        <GradientStop Offset="1" Color="{StaticResource AccentVioletColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#06B6D4" />
        <GradientStop Offset="0.5" Color="#2563EB" />
        <GradientStop Offset="1" Color="{StaticResource AccentVioletColor}" />
    </LinearGradientBrush>

    <!-- The app bar across the top of the main window. -->
    <LinearGradientBrush x:Key="AppBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#1E3A8A" />
        <GradientStop Offset="0.55" Color="#3730A3" />
        <GradientStop Offset="1" Color="#6D28D9" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppBarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBarTextSoft" Color="#D5DCFF" />

    <!-- A PDF, wherever one is named on its own: the red the format is known by. -->
    <LinearGradientBrush x:Key="PdfBadge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E11D48" />
        <GradientStop Offset="1" Color="#F97316" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBackground" Color="#EEF2FB" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F3F6FD" />
    <!-- The job page behind the fields: tinted, so the white fields stand out on it. -->
    <SolidColorBrush x:Key="Page" Color="#F7F8FE" />
    <!-- The queue sidebar, and a row in it under the mouse. -->
    <SolidColorBrush x:Key="Sidebar" Color="#E9EEFB" />
    <SolidColorBrush x:Key="SidebarHover" Color="#DCE4F8" />
    <SolidColorBrush x:Key="Border" Color="#DCE2F0" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C3CCE0" />

    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5B6782" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Success" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Warning" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Waiting" Color="#0369A1" />
    <SolidColorBrush x:Key="WaitingSoft" Color="#E0F2FE" />

    <!-- One hue per section, for its heading chip. Dark enough to read on white. -->
    <SolidColorBrush x:Key="HueViolet" Color="#7C3AED" />
    <SolidColorBrush x:Key="HueAmber" Color="#D97706" />
    <SolidColorBrush x:Key="HueTeal" Color="#0D9488" />
    <SolidColorBrush x:Key="HueBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="HuePink" Color="#DB2777" />
    <SolidColorBrush x:Key="HueGreen" Color="#059669" />
    <SolidColorBrush x:Key="HueIndigo" Color="#4F46E5" />
    <SolidColorBrush x:Key="HueRed" Color="#DC2626" />
    <SolidColorBrush x:Key="HueSlate" Color="#475569" />
    <!-- The plan summary sits on the green of its heading. -->
    <SolidColorBrush x:Key="PlanSoft" Color="#ECFDF5" />
    <SolidColorBrush x:Key="PlanBorder" Color="#A7F3D0" />

    <!-- Filled buttons, so dark mode can use a deeper blue than its link text. -->
    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBorder" Color="#FCA5A5" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#DCE3F5" />
    <!-- The dashed "drop PDFs here" area. -->
    <SolidColorBrush x:Key="DropStroke" Color="#A5B4FC" />
    <SolidColorBrush x:Key="DropFill" Color="#EEF2FF" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C3CCE0" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#94A3B8" />


</ResourceDictionary>
