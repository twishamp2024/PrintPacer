<Window x:Class="PrintPacer.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unfinished job found" Height="520" Width="680"
        MinHeight="380" MinWidth="560"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Manual" UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource AppBar}" Padding="22,18">
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource Title}" Foreground="{DynamicResource AppBarText}" />
                <TextBlock x:Name="Subhead" Style="{StaticResource Secondary}" Foreground="{DynamicResource AppBarTextSoft}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="22,16" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Reports">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}"
                                           Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding Details}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Secondary}"
                                                       FontSize="12.5" Margin="0,3" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock x:Name="Advice" Style="{StaticResource Secondary}" FontSize="12"
                           VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left" />
                <Button Content="Continue" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Click="OnClose" MinWidth="120" />
            </Grid>
        </Border>
    </Grid>
</Window>
