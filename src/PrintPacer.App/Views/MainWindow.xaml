<Window x:Class="PrintPacer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PrintPacer.App.Views"
        Title="PrintPacer" Height="820" Width="1000"
        MinHeight="620" MinWidth="880"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">

    <Window.Resources>
        <v:BoolToVisibility x:Key="Show" />
        <v:InverseBoolToVisibility x:Key="Hide" />
        <v:InverseBool x:Key="Not" />
        <v:TextToVisibility x:Key="ShowText" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="PrintPacer" Style="{StaticResource Title}" />
                    <TextBlock Text="Print large PDFs in paced batches, so the printer gets a rest in between."
                               Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Print queue" Style="{StaticResource LinkButton}"
                            Command="{Binding OpenQueueCommand}"
                            ToolTip="Open the Windows print queue for this printer" />
                    <Button Content="Printer settings" Style="{StaticResource LinkButton}"
                            Command="{Binding OpenPrinterSettingsCommand}" />
                    <Button Content="Logs" Style="{StaticResource LinkButton}"
                            Command="{Binding OpenLogFolderCommand}" />
                    <Button Content="Settings" Style="{StaticResource SecondaryButton}"
                            Click="OnSettings" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22">
            <Grid>

                <!-- ============ SETUP ============ -->
                <StackPanel Visibility="{Binding ShowSetup, Converter={StaticResource Show}}"
                            MaxWidth="820" HorizontalAlignment="Stretch">

                    <!-- Drop zone / document -->
                    <Border x:Name="DropZone" Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasDocument, Converter={StaticResource Hide}}">
                        <Border x:Name="DropTarget" Margin="10" CornerRadius="8" Padding="40,46"
                                Background="{StaticResource SurfaceMuted}"
                                BorderBrush="{StaticResource BorderStrong}" BorderThickness="2">
                            <Border.Resources>
                                <Style TargetType="Border" />
                            </Border.Resources>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Drop a PDF here" Style="{StaticResource Display}"
                                           FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="or choose one from your computer"
                                           Style="{StaticResource Secondary}" HorizontalAlignment="Center"
                                           Margin="0,6,0,18" />
                                <Button Content="Browse…" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseCommand}" HorizontalAlignment="Center"
                                        Padding="22,10" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasDocument, Converter={StaticResource Show}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DOCUMENT" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding DocumentName}" Style="{StaticResource Title}" />
                                <TextBlock Text="{Binding DocumentPages}" Style="{StaticResource Body}"
                                           FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding DocumentDetail}" Style="{StaticResource Secondary}"
                                           FontSize="12.5" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding DocumentWarning}" Style="{StaticResource Secondary}"
                                           FontSize="12" Foreground="{StaticResource Warning}" Margin="0,6,0,0"
                                           Visibility="{Binding DocumentWarning, Converter={StaticResource ShowText}}" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Choose another"
                                    Style="{StaticResource LinkButton}" VerticalAlignment="Top"
                                    Command="{Binding ClearDocumentCommand}" />
                        </Grid>
                    </Border>

                    <!-- Configuration -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PRINTER" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              ItemsSource="{Binding Printers}"
                                              SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding PrinterHint}" Style="{StaticResource Secondary}"
                                               FontSize="11.5" Margin="2,5,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PAGES PER BATCH" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Field}" Height="38"
                                             Text="{Binding PagesPerBatch, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="REST BETWEEN BATCHES" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <TextBox Style="{StaticResource Field}" Height="38"
                                                 Text="{Binding DelayMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="minutes" Style="{StaticResource Secondary}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,16,0,0">
                                    <TextBlock Text="PRINT MODE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}" Width="220" HorizontalAlignment="Left"
                                              AutomationProperties.Name="Print mode"
                                              ItemsSource="{Binding ColourModes}"
                                              DisplayMemberPath="Label" SelectedValuePath="Mode"
                                              SelectedValue="{Binding ColourMode, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding ColourModeNote}" Style="{StaticResource Secondary}"
                                               Foreground="{Binding ColourModeNoteBrush}"
                                               FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding ColourModeNote, Converter={StaticResource ShowText}}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <CheckBox Content="Start later" Style="{StaticResource Check}"
                                          IsChecked="{Binding StartLater, Mode=TwoWay}" />
                                <DatePicker Margin="16,0,0,0" Width="150" VerticalAlignment="Center"
                                            SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                            IsEnabled="{Binding StartLater}" />
                                <TextBox Style="{StaticResource Field}" Width="90" Height="32" Margin="10,0,0,0"
                                         VerticalAlignment="Center"
                                         IsEnabled="{Binding StartLater}"
                                         Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="24-hour time, e.g. 23:30" Style="{StaticResource Secondary}"
                                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Invoice -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Content="Print an invoice when the job finishes" Style="{StaticResource Check}"
                                      Margin="0" IsChecked="{Binding PrintInvoice, Mode=TwoWay}" />

                            <StackPanel Visibility="{Binding PrintInvoice, Converter={StaticResource Show}}">
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PRICE PER BLACK &amp; WHITE PAGE" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <TextBox Style="{StaticResource Field}" Height="38"
                                                     AutomationProperties.Name="Price per black and white page"
                                                     Text="{Binding BlackWhitePrice, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource Secondary}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PRICE PER COLOUR PAGE" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <TextBox Style="{StaticResource Field}" Height="38"
                                                     AutomationProperties.Name="Price per colour page"
                                                     Text="{Binding ColourPrice, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource Secondary}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Each page is checked for colour automatically, and charged at the matching rate."
                                           Style="{StaticResource Secondary}" FontSize="12" Margin="2,10,0,0" />

                                <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,11"
                                        Background="{StaticResource SurfaceMuted}">
                                    <TextBlock Text="{Binding InvoiceEstimate}" Style="{StaticResource Mono}"
                                               Foreground="{StaticResource TextPrimary}" LineHeight="21"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Schedule preview -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Background="{StaticResource SurfaceMuted}">
                        <StackPanel>
                            <TextBlock Text="WHAT WILL HAPPEN" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding BatchPreview}" Style="{StaticResource Mono}"
                                       Foreground="{StaticResource TextPrimary}" LineHeight="21" />
                        </StackPanel>
                    </Border>

                    <!-- Problems -->
                    <Border Margin="0,16,0,0" CornerRadius="8" Padding="14,11"
                            Background="{StaticResource WarningSoft}"
                            Visibility="{Binding HasSetupProblem, Converter={StaticResource Show}}">
                        <TextBlock Text="{Binding SetupProblem}" Style="{StaticResource Body}"
                                   Foreground="{StaticResource Warning}" />
                    </Border>

                    <Button Content="START PRINTING" Style="{StaticResource HeroButton}"
                            Command="{Binding StartCommand}" Margin="0,20,0,10"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- ============ DASHBOARD ============ -->
                <StackPanel Visibility="{Binding ShowDashboard, Converter={StaticResource Show}}"
                            MaxWidth="900" HorizontalAlignment="Stretch">

                    <!-- Progress card -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding JobDocument}" Style="{StaticResource Title}" />
                                    <TextBlock Text="{Binding JobSubtitle}" Style="{StaticResource Secondary}"
                                               FontSize="12.5" Margin="0,3,0,0" />
                                </StackPanel>

                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Background="{Binding StateBackground}">
                                    <TextBlock Text="{Binding StateHeadline}" Style="{StaticResource PillText}"
                                               Foreground="{Binding StateForeground}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,20,0,0">
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Display}"
                                           FontSize="26" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Visibility="{Binding HasCountdown, Converter={StaticResource Show}}">
                                    <TextBlock Text="{Binding CountdownCaption}" Style="{StaticResource FieldLabel}"
                                               HorizontalAlignment="Right" Margin="0" />
                                    <TextBlock Text="{Binding Countdown}" Style="{StaticResource Display}"
                                               FontSize="22" Foreground="{StaticResource Waiting}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar Style="{StaticResource Progress}" Margin="0,12,0,0"
                                         Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />

                            <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Secondary}"
                                       Margin="0,14,0,0"
                                       Visibility="{Binding StateDetail, Converter={StaticResource ShowText}}" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CURRENT BATCH" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CurrentBatchText}" Style="{StaticResource Body}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="NEXT BATCH" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding NextBatchText}" Style="{StaticResource Body}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Controls -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Pause" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding PauseCommand}"
                                        IsEnabled="{Binding CanPause}" />
                                <Button Content="Resume" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                        Command="{Binding ResumeCommand}"
                                        IsEnabled="{Binding CanResume}" />
                                <Button Content="Cancel queued batch" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        Command="{Binding CancelQueuedBatchCommand}"
                                        IsEnabled="{Binding IsPrintingNow}"
                                        ToolTip="Remove the batch that is currently in the Windows print queue" />
                                <Button Content="Cancel job" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                        Command="{Binding CancelCommand}"
                                        IsEnabled="{Binding CanCancel}" />
                                <Button Content="Start a new job" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        Command="{Binding NewJobCommand}"
                                        Visibility="{Binding IsFinished, Converter={StaticResource Show}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding PauseExplanation}" Style="{StaticResource Secondary}"
                                       FontSize="12" Margin="2,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Invoice -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding ShowInvoice, Converter={StaticResource Show}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="INVOICE" Style="{StaticResource FieldLabel}" />
                                <Button Content="{Binding PrintInvoiceLabel}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,6"
                                        FontSize="12.5"
                                        Command="{Binding PrintInvoiceCommand}"
                                        Visibility="{Binding CanPrintInvoice, Converter={StaticResource Show}}" />
                            </Grid>
                            <TextBlock Text="{Binding InvoiceCharges}" Style="{StaticResource Mono}"
                                       Foreground="{StaticResource TextPrimary}" LineHeight="21" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding InvoiceStatus}" Style="{StaticResource Secondary}"
                                       FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Batch history -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="BATCHES" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Batches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9" BorderBrush="{StaticResource Border}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="{Binding StatusForeground}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Heading}"
                                                               Style="{StaticResource Body}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Range}"
                                                               Style="{StaticResource Secondary}"
                                                               VerticalAlignment="Center" />

                                                    <Border Grid.Column="3" Style="{StaticResource Pill}"
                                                            Background="{Binding StatusBackground}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource PillText}"
                                                                   Foreground="{Binding StatusForeground}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}"
                                                           FontSize="12" Margin="30,6,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource Show}}" />

                                                <StackPanel Orientation="Horizontal" Margin="26,8,0,2"
                                                            Visibility="{Binding NeedsDecision, Converter={StaticResource Show}}">
                                                    <Button Content="These pages did print"
                                                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                                                            FontSize="12.5"
                                                            Command="{Binding DataContext.ConfirmPrintedCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="They did not — send again"
                                                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                                                            FontSize="12.5" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ConfirmNotPrintedCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6"
                                                            FontSize="12.5" Margin="8,0,0,0"
                                                            Visibility="{Binding CanResumeFrom, Converter={StaticResource Show}}"
                                                            Command="{Binding DataContext.ResumeFromCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock>
                                                            <Run Text="Keep the" />
                                                            <Run Text="{Binding ConfirmedPages, Mode=OneWay}" />
                                                            <Run Text="that printed, send the rest" />
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Activity -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ACTIVITY" Style="{StaticResource FieldLabel}" />
                                <Button Content="Export log…" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0"
                                        Command="{Binding ExportLogCommand}" />
                            </Grid>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          x:Name="ActivityScroller">
                                <ItemsControl ItemsSource="{Binding RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="26,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding PrinterStatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PrinterStatus}" Style="{StaticResource Secondary}"
                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeviceStatus}" Style="{StaticResource Secondary}"
                               FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasDeviceStatus, Converter={StaticResource Show}}" />
                </StackPanel>

                <TextBlock Text="Closing this window keeps the job running in the notification area."
                           Style="{StaticResource Secondary}" FontSize="11.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
