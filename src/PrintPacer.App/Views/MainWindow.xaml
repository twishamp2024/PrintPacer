<Window x:Class="PrintPacer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PrintPacer.App.Views"
        Title="PrintPacer" Height="880" Width="1320"
        MinHeight="640" MinWidth="1100"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">

    <!--
        One queue on the left, one job on the right.

        The queue is a list with a single action under it - Start printing - which starts every
        job that is ready, so it lives with the queue and appears nowhere else. The job side is a
        plain page: sections separated by a hairline and a heading, not a stack of boxes.
        Colour is kept for state (a job printing, a job that needs you) and for that one action.
    -->

    <Window.Resources>
        <v:BoolToVisibility x:Key="Show" />
        <v:InverseBoolToVisibility x:Key="Hide" />
        <v:InverseBool x:Key="Not" />
        <v:TextToVisibility x:Key="ShowText" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Background="{StaticResource AppBar}" Padding="18,10,16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="Print many PDFs in paced batches, one job after another, so the printer gets a rest in between.">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#33FFFFFF" Margin="0,0,10,0">
                        <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource AppBarText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PrintPacer" Style="{StaticResource Title}" FontSize="16"
                               Foreground="{StaticResource AppBarText}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Print queue" Style="{StaticResource AppBarLink}"
                            Command="{Binding OpenQueueCommand}"
                            ToolTip="Open the Windows print queue for this printer" />
                    <Button Content="Printer settings" Style="{StaticResource AppBarLink}"
                            Command="{Binding OpenPrinterSettingsCommand}"
                            ToolTip="Open the printers page of Windows Settings" />
                    <Button Content="Logs" Style="{StaticResource AppBarLink}"
                            Command="{Binding OpenLogFolderCommand}"
                            ToolTip="Open the folder with PrintPacer's log files" />
                    <Button Content="Settings" Style="{StaticResource AppBarButton}" Padding="12,5"
                            Click="OnSettings" Margin="8,0,0,0"
                            ToolTip="Defaults for new jobs, overnight behaviour, notifications" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ QUEUE ============ -->
            <Border Grid.Column="0" Background="{StaticResource Sidebar}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,16,14,10">
                        <Grid>
                            <v:SectionTitle Text="Queue" Glyph="&#xE8FD;" Hue="{StaticResource HueIndigo}"
                                            Margin="0" VerticalAlignment="Center" />
                            <Button Content="Add PDFs…" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-4,0,-4"
                                    Command="{Binding BrowseCommand}"
                                    ToolTip="Choose one or more PDFs. Each becomes its own job." />
                        </Grid>
                        <TextBlock Text="{Binding QueueOverview}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding AddingStatus}" Style="{StaticResource Hint}"
                               Foreground="{StaticResource Accent}" Margin="20,0,20,10"
                               Visibility="{Binding AddingStatus, Converter={StaticResource ShowText}}" />

                    <!-- Files that could not be added, each with its reason. Never dropped silently. -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Callout}" Margin="14,0,14,10"
                            Visibility="{Binding HasNotices, Converter={StaticResource Show}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Please look at these files" Style="{StaticResource Body}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource Warning}"
                                           VerticalAlignment="Center" />
                                <Button Content="Dismiss" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,-5,-8,-5" Padding="6,3"
                                        Command="{Binding DismissNoticesCommand}" />
                            </Grid>
                            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding IntakeNotices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource TextPrimary}" Margin="0,2">
                                                <Run Text="{Binding Icon, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Warning}" />
                                                <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="—" Foreground="{StaticResource TextSecondary}" />
                                                <Run Text="{Binding Message, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- The queue's one action, and the place to drop more files. -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                            Padding="14,10,14,12">
                        <StackPanel>
                            <Grid Height="36" Margin="0,0,0,10"
                                  Visibility="{Binding HasJobs, Converter={StaticResource Show}}"
                                  ToolTip="Drop PDFs anywhere in this window. Each becomes its own job.">
                                <Rectangle x:Name="QueueDropTarget" RadiusX="6" RadiusY="6"
                                           Stroke="{StaticResource BorderStrong}" StrokeThickness="1.2"
                                           StrokeDashArray="4 3" Fill="Transparent" />
                                <TextBlock Text="Drop more PDFs here" Style="{StaticResource Hint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <Button Content="{Binding StartQueueLabel}" Style="{StaticResource HeroButton}"
                                    Command="{Binding StartQueueCommand}" HorizontalAlignment="Stretch"
                                    ToolTip="Starts every job that has not started, one after another, in this order" />
                            <Button Content="Clear finished jobs" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Center" Margin="0,4,0,-4"
                                    Command="{Binding ClearFinishedCommand}"
                                    Visibility="{Binding HasFinishedJobs, Converter={StaticResource Show}}"
                                    ToolTip="Remove finished and cancelled jobs from the list. Their history stays in the log." />
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource QueueItem}"
                             Background="Transparent" BorderThickness="0" Padding="8,0,8,8"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Grid.IsSharedSizeScope="True"
                             AutomationProperties.Name="Print queue">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="900">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="Number" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- The job's place in the queue, in a chip tinted with its status colour. -->
                                    <Grid Grid.Column="0" MinWidth="24" Height="20" HorizontalAlignment="Left"
                                          VerticalAlignment="Top" Margin="-3,0,8,0">
                                        <Border CornerRadius="10" Background="{Binding BadgeForeground}" Opacity="0.15" />
                                        <TextBlock Text="{Binding Number}" Style="{StaticResource Hint}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource Body}"
                                               FontWeight="SemiBold" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                    <!-- Status: a dot and a word, so it never depends on colour alone. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusForeground}"
                                                 VerticalAlignment="Center" Margin="0,1,6,0" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}"
                                                   FontSize="11.5" Foreground="{Binding StatusForeground}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,8,0">
                                        <TextBlock Text="{Binding WhatLine}" Style="{StaticResource Hint}" FontSize="11.5" />
                                        <TextBlock Text="{Binding HowLine}" Style="{StaticResource Hint}" FontSize="11.5" />
                                        <ProgressBar Style="{StaticResource Progress}" Height="4" Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,7,0,0"
                                                     Visibility="{Binding ShowProgress, Converter={StaticResource Show}}" />
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" FontSize="11"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding ShowProgress, Converter={StaticResource Show}}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11.5"
                                                   Foreground="{Binding DetailForeground}" Margin="0,4,0,0"
                                                   MaxHeight="48" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource Show}}" />
                                    </StackPanel>

                                    <!-- Order and remove: quiet until pointed at. -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,4,-4,-4">
                                        <Button Content="▲" Style="{StaticResource IconButton}"
                                                Visibility="{Binding IsWaiting, Converter={StaticResource Show}}"
                                                IsEnabled="{Binding CanMoveUp}"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Print earlier" AutomationProperties.Name="Move up" />
                                        <Button Content="▼" Style="{StaticResource IconButton}"
                                                Visibility="{Binding IsWaiting, Converter={StaticResource Show}}"
                                                IsEnabled="{Binding CanMoveDown}"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Print later" AutomationProperties.Name="Move down" />
                                        <Button Content="✕" Style="{StaticResource IconButton}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource Show}}"
                                                Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove from the list" AutomationProperties.Name="Remove" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource Page}" Padding="32,20,32,24">
            <Grid>

                <!-- ============ NO JOBS YET ============ -->
                <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource Show}}"
                            Width="560" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <Grid x:Name="DropZone">
                        <Rectangle x:Name="DropTarget" RadiusX="10" RadiusY="10"
                                   Stroke="#A5B4FC" StrokeThickness="1.5" StrokeDashArray="5 4"
                                   Fill="#EEF2FF" />
                        <StackPanel HorizontalAlignment="Center" Margin="40,52,40,48">
                            <!-- A page with a folded corner and an arrow into it. -->
                            <Canvas Width="36" Height="44" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Stroke="{StaticResource HueViolet}" Fill="{StaticResource Surface}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M 1 1 L 24 1 L 35 12 L 35 43 L 1 43 Z M 24 1 L 24 12 L 35 12" />
                                <Path Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 18 18 L 18 34 M 12 28 L 18 34 L 24 28" />
                            </Canvas>
                            <TextBlock Text="Drop PDFs here" Style="{StaticResource Display}" FontSize="22"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="You can add one or many PDFs at once." Style="{StaticResource Secondary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,20" />
                            <Button Content="Browse files…" Style="{StaticResource HeroButton}"
                                    Command="{Binding BrowseCommand}" HorizontalAlignment="Center"
                                    Padding="20,9" />
                        </StackPanel>
                    </Grid>

                    <ToggleButton x:Name="HowItWorks" Content="How the queue works" Style="{StaticResource Disclosure}"
                                  Margin="2,16,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" LineHeight="22" Margin="18,6,0,0"
                               Visibility="{Binding IsChecked, ElementName=HowItWorks, Converter={StaticResource Show}}">
                        1.  Every PDF becomes its own job, set up from your defaults (Settings).<LineBreak />
                        2.  Click a job to check or change its settings. They belong to that job only.<LineBreak />
                        3.  Put the jobs in the order you want with ▲ and ▼.<LineBreak />
                        4.  Press Start printing. Jobs print one after another, each in its own paced
                        batches, with the printer resting between batches and between jobs.
                    </TextBlock>
                </StackPanel>

                <!-- ============ SETUP: a job that has not started ============ -->
                <StackPanel Visibility="{Binding ShowSetup, Converter={StaticResource Show}}"
                            MaxWidth="860" HorizontalAlignment="Stretch">

                    <!-- The job -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="48" CornerRadius="8" Background="{StaticResource PdfBadge}"
                                VerticalAlignment="Top" Margin="0,2,14,0">
                            <TextBlock Text="PDF" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding EditorJobLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding DocumentName}" Style="{StaticResource Title}" FontSize="20"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DocumentName}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding DocumentPages, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimary}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding DocumentDetail, Mode=OneWay}" FontSize="12.5" />
                            </TextBlock>
                            <TextBlock Text="{Binding DocumentWarning}" Style="{StaticResource Hint}"
                                       Foreground="{StaticResource Warning}" Margin="0,6,0,0"
                                       Visibility="{Binding DocumentWarning, Converter={StaticResource ShowText}}" />
                            <TextBlock Text="{Binding EditorStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Visibility="{Binding EditorStatus, Converter={StaticResource ShowText}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,12,0,0">
                            <Button Content="Hold back" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                    Command="{Binding HoldJobCommand}" Margin="0,0,4,0"
                                    Visibility="{Binding CanHold, Converter={StaticResource Show}}"
                                    ToolTip="Take this job out of the queue without removing it. Start it again later." />
                            <Button Content="Remove" Style="{StaticResource LinkButton}" Margin="0,0,-8,0"
                                    Command="{Binding RemoveJobCommand}"
                                    ToolTip="Remove this job from the queue" />
                        </StackPanel>
                    </Grid>

                    <!-- Print settings: what is printed, and how it is laid out on the paper. Comes
                         before batching, because batches divide whatever these produce. -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <v:SectionTitle Text="Print settings" Glyph="&#xE7C3;" Hue="{StaticResource HueViolet}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Pages" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Pages to print"
                                              ItemsSource="{Binding PageSelections}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding PageSelection, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Layout" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Layout"
                                              ItemsSource="{Binding Layouts}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Layout, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Sides" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Single or double-sided"
                                              IsEnabled="{Binding CanChooseSides}"
                                              ToolTip="Booklets and brochures are always double-sided"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTipService.IsEnabled="{Binding CanChooseSides, Converter={StaticResource Not}}"
                                              ItemsSource="{Binding SidesChoices}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding DoubleSided, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- Double-sided: which way the sheet turns over -->
                            <Grid Margin="0,12,0,0" Visibility="{Binding ShowFlip, Converter={StaticResource Show}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Flip on" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Flip on"
                                              ItemsSource="{Binding FlipChoices}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Flip, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding SidesHint}" Style="{StaticResource Hint}"
                                               Visibility="{Binding SidesHint, Converter={StaticResource ShowText}}" />
                                    <TextBlock Text="{Binding FlipHint}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Visibility="{Binding FlipHint, Converter={StaticResource ShowText}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Booklet -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBooklet, Converter={StaticResource Show}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Binding" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource Dropdown}"
                                                  AutomationProperties.Name="Booklet binding"
                                                  ItemsSource="{Binding Bindings}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Binding, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.ColumnSpan="3">
                                        <TextBlock Text="Folded in" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource Dropdown}"
                                                  AutomationProperties.Name="Sheets per folded section"
                                                  ItemsSource="{Binding SectionChoices}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SheetsPerSection, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Style="{StaticResource Check}" Margin="0,12,0,0"
                                          Content="Keep the last page as the back cover (any blank pages go just before it)"
                                          IsChecked="{Binding KeepBackCover, Mode=TwoWay}" />
                                <TextBlock Text="{Binding BookletNote}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Brochure -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBrochure, Converter={StaticResource Show}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fold" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource Dropdown}"
                                                  AutomationProperties.Name="Brochure fold"
                                                  ItemsSource="{Binding Folds}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Fold, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding BrochurePanelOrder}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- The sheet: shared by booklet and brochure -->
                            <Grid Margin="0,12,0,0" Visibility="{Binding IsImposed, Converter={StaticResource Show}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Paper" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Paper size"
                                              ItemsSource="{Binding Papers}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Paper, Mode=TwoWay}" />
                                </StackPanel>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Margin" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <TextBox Style="{StaticResource Field}"
                                                     AutomationProperties.Name="Margin in millimetres"
                                                     Text="{Binding MarginMm, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="mm" Style="{StaticResource Hint}" IsHitTestVisible="False"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="At fold" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Space left blank at each fold" />
                                        <Grid>
                                            <TextBox Style="{StaticResource Field}"
                                                     AutomationProperties.Name="Space at each fold in millimetres"
                                                     ToolTip="Space left blank at each fold"
                                                     Text="{Binding FoldGapMm, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="mm" Style="{StaticResource Hint}" IsHitTestVisible="False"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Page size" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Page scaling"
                                              ItemsSource="{Binding Scalings}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Scaling, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- What the printer's driver said about sides, paper and orientation -->
                            <TextBlock Text="{Binding PrinterSetupNote}" Style="{StaticResource Hint}"
                                       Foreground="{Binding PrinterSetupNoteBrush}" Margin="0,10,0,0"
                                       Visibility="{Binding PrinterSetupNote, Converter={StaticResource ShowText}}" />

                            <!-- The first sheets, so the arrangement can be checked before printing -->
                            <Border Margin="0,12,0,0" CornerRadius="6" Padding="12,9"
                                    Background="{StaticResource SurfaceMuted}"
                                    Visibility="{Binding SheetMap, Converter={StaticResource ShowText}}">
                                <StackPanel>
                                    <TextBlock Text="First sheets: page numbers left to right; · is a blank page"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SheetMap}" Style="{StaticResource Mono}"
                                               Foreground="{StaticResource TextPrimary}" LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                        Visibility="{Binding ShowPrintDetails, Converter={StaticResource Show}}">
                                <Button Content="Preview layout as PDF…" Style="{StaticResource SecondaryButton}"
                                        Padding="12,5"
                                        Command="{Binding PreviewLayoutCommand}"
                                        ToolTip="Draws the first sheets exactly as they will print, into a PDF, using Microsoft Print to PDF. Nothing is sent to your printer." />
                                <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Hint}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" ToolTip="{Binding PreviewStatus}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Batching -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <v:SectionTitle Text="Batching" Glyph="&#xE81E;" Hue="{StaticResource HueAmber}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding BatchSizeLabel}" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <TextBox Style="{StaticResource Field}"
                                                 AutomationProperties.Name="{Binding BatchSizeLabel}"
                                                 Text="{Binding PagesPerBatch, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding BatchSizeHint}" Style="{StaticResource Hint}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                                   Visibility="{Binding BatchSizeHint, Converter={StaticResource ShowText}}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rest between batches" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <TextBox Style="{StaticResource Field}"
                                                 AutomationProperties.Name="Rest between batches in minutes"
                                                 Text="{Binding DelayMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="minutes" Style="{StaticResource Hint}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Printer -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <v:SectionTitle Text="Printer" Glyph="&#xE749;" Hue="{StaticResource HueTeal}" />
                            <!-- The printer gets the width a long queue name needs; mode and quality are short. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Printer" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Printer"
                                              ToolTip="{Binding SelectedPrinter}"
                                              ItemsSource="{Binding Printers}"
                                              SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Print mode" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Print mode"
                                              ItemsSource="{Binding ColourModes}"
                                              DisplayMemberPath="Label" SelectedValuePath="Mode"
                                              SelectedValue="{Binding ColourMode, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Render quality" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Dropdown}"
                                              AutomationProperties.Name="Render quality"
                                              ItemsSource="{Binding RenderDpiChoices}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding RenderDpi, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding PrinterHint}" Style="{StaticResource Hint}" Margin="0,5,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrinterHint}"
                                       Visibility="{Binding PrinterHint, Converter={StaticResource ShowText}}" />
                            <TextBlock Text="{Binding ColourModeNote}" Style="{StaticResource Hint}"
                                       Foreground="{Binding ColourModeNoteBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding ColourModeNote, Converter={StaticResource ShowText}}" />
                        </StackPanel>
                    </Border>

                    <!-- Schedule -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <v:SectionTitle Text="Schedule" Glyph="&#xE787;" Hue="{StaticResource HueBlue}" />
                            <!-- The date and time appear once they mean something, rather than sitting greyed out. -->
                            <StackPanel Orientation="Horizontal" MinHeight="34">
                                <CheckBox Content="Don't start before" Style="{StaticResource Check}" Margin="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding StartLater, Mode=TwoWay}"
                                          ToolTip="The job still waits for the jobs ahead of it in the queue" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding StartLater, Converter={StaticResource Show}}">
                                    <DatePicker Style="{StaticResource DateField}" Margin="14,0,0,0" Width="150"
                                                AutomationProperties.Name="Start date"
                                                SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                                IsEnabled="{Binding StartLater}" />
                                    <TextBox Style="{StaticResource Field}" Width="80" Margin="8,0,0,0"
                                             AutomationProperties.Name="Start time, 24-hour"
                                             IsEnabled="{Binding StartLater}"
                                             Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="24-hour time, e.g. 23:30" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Additional options -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <v:SectionTitle Text="Additional options" Glyph="&#xE8C7;" Hue="{StaticResource HuePink}" />
                            <CheckBox Content="Print an invoice when the job finishes" Style="{StaticResource Check}"
                                      Margin="0" IsChecked="{Binding PrintInvoice, Mode=TwoWay}"
                                      ToolTip="Each page is checked for colour automatically, and charged at the matching rate." />

                            <StackPanel Visibility="{Binding PrintInvoice, Converter={StaticResource Show}}" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Price per black &amp; white page" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <TextBox Style="{StaticResource Field}"
                                                     AutomationProperties.Name="Price per black and white page"
                                                     Text="{Binding BlackWhitePrice, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource Hint}" IsHitTestVisible="False"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Price per colour page" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <TextBox Style="{StaticResource Field}"
                                                     AutomationProperties.Name="Price per colour page"
                                                     Text="{Binding ColourPrice, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource Hint}" IsHitTestVisible="False"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Bottom"
                                               Text="Each page is checked for colour and charged at the matching rate." />
                                </Grid>

                                <TextBlock Text="{Binding InvoiceEstimate}" Style="{StaticResource Mono}"
                                           Foreground="{StaticResource TextPrimary}" LineHeight="20" Margin="0,12,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- What will happen: the plan at a glance, and the batch-by-batch schedule on request -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <v:SectionTitle Text="What will happen" Glyph="&#xE9D5;" Hue="{StaticResource HueGreen}" />

                            <Border Background="{StaticResource PlanSoft}" BorderBrush="{StaticResource PlanBorder}"
                                    BorderThickness="3,0,0,0" CornerRadius="6" Padding="12,7,12,8">
                            <StackPanel>
                            <TextBlock Text="{Binding BatchPreview.Headline}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatchPreview.IsProblem}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding BatchPreview.Timing}" Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                       Visibility="{Binding BatchPreview.Timing, Converter={StaticResource ShowText}}" />
                            <TextBlock Text="{Binding BatchPreview.Start}" Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                       Visibility="{Binding BatchPreview.Start, Converter={StaticResource ShowText}}" />
                            <TextBlock Text="{Binding BatchPreview.Layout}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Visibility="{Binding BatchPreview.Layout, Converter={StaticResource ShowText}}" />
                            </StackPanel>
                            </Border>

                            <!-- A problem found in the choices: said once, here, and on the job's row -->
                            <Border Style="{StaticResource Callout}" Margin="0,10,0,0"
                                    Visibility="{Binding ShowSetupProblem, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding SetupProblem}" Style="{StaticResource Body}" FontSize="13"
                                           Foreground="{StaticResource Warning}" />
                            </Border>

                            <StackPanel Visibility="{Binding BatchPreview.HasSchedule, Converter={StaticResource Show}}">
                                <ToggleButton x:Name="ScheduleToggle" Content="View schedule" Style="{StaticResource Disclosure}"
                                              Margin="0,8,0,0" AutomationProperties.Name="View the batch schedule" />
                                <StackPanel Margin="17,4,0,0"
                                            Visibility="{Binding IsChecked, ElementName=ScheduleToggle, Converter={StaticResource Show}}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding BatchPreview.Schedule}" Grid.IsSharedSizeScope="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Batch" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Range" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Batch}" Style="{StaticResource Hint}"
                                                                   FontSize="12.5" Margin="0,0,16,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Range}" Style="{StaticResource Body}"
                                                                   FontSize="12.5" Margin="0,0,20,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Hint}"
                                                                   FontSize="12.5" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="{Binding BatchPreview.ScheduleNote}" Style="{StaticResource Hint}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding BatchPreview.ScheduleNote, Converter={StaticResource ShowText}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Saving, and settings for more than this one job -->
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SaveNote}" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,-8,0">
                                <Button Content="Copy to other jobs…" Style="{StaticResource LinkButton}"
                                        Command="{Binding CopyToOthersCommand}"
                                        ToolTip="Give every other job that has not started a copy of these settings. Each can still be changed on its own." />
                                <Button Content="Use as defaults" Style="{StaticResource LinkButton}"
                                        Command="{Binding UseAsDefaultsCommand}"
                                        ToolTip="New PDFs you add will start with these settings. Jobs already in the list keep their own." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ============ A JOB THAT HAS STARTED, OR FINISHED ============ -->
                <StackPanel Visibility="{Binding ShowDashboard, Converter={StaticResource Show}}"
                            MaxWidth="900" HorizontalAlignment="Stretch">

                    <!-- The job, and where it stands -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="48" CornerRadius="8" Background="{StaticResource PdfBadge}"
                                VerticalAlignment="Top" Margin="0,2,14,0">
                            <TextBlock Text="PDF" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding JobDocument}" Style="{StaticResource Title}" FontSize="20"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding JobDocument}" />
                            <TextBlock Text="{Binding JobSubtitle}" Style="{StaticResource Hint}" FontSize="12.5"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding JobPrintSettings}" Style="{StaticResource Hint}" FontSize="12.5"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding JobPrintSettings, Converter={StaticResource ShowText}}" />
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="16,2,0,0"
                                Background="{Binding StateBackground}">
                            <TextBlock Text="{Binding StateHeadline}" Style="{StaticResource PillText}"
                                       Foreground="{Binding StateForeground}" />
                        </Border>
                    </Grid>

                    <!-- Progress -->
                    <Grid Margin="0,22,0,0">
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Display}" FontSize="22"
                                   VerticalAlignment="Bottom" />
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="{Binding HasCountdown, Converter={StaticResource Show}}">
                            <TextBlock Text="{Binding CountdownCaption}" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right" Margin="0" />
                            <TextBlock Text="{Binding Countdown}" Style="{StaticResource Display}"
                                       FontSize="20" Foreground="{StaticResource Waiting}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Style="{StaticResource Progress}" Height="8" Margin="0,10,0,0"
                                 Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                 AutomationProperties.Name="Progress" />

                    <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Secondary}" Margin="0,10,0,0"
                               Visibility="{Binding StateDetail, Converter={StaticResource ShowText}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current batch" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding CurrentBatchText}" Style="{StaticResource Body}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Next batch" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding NextBatchText}" Style="{StaticResource Body}" />
                        </StackPanel>
                    </Grid>

                    <!-- Controls. A finished job can only be removed, so the rest step aside. -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                    Visibility="{Binding IsFinished, Converter={StaticResource Hide}}">
                            <Button Content="Pause" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding PauseCommand}"
                                    IsEnabled="{Binding CanPause}" />
                            <Button Content="Resume" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding ResumeCommand}"
                                    IsEnabled="{Binding CanResume}" />
                            <Button Content="Cancel queued batch" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding CancelQueuedBatchCommand}"
                                    IsEnabled="{Binding IsPrintingNow}"
                                    ToolTip="Remove the batch that is currently in the Windows print queue" />
                            <Button Content="Cancel job" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                    Command="{Binding CancelCommand}"
                                    IsEnabled="{Binding CanCancel}" />
                        </StackPanel>
                        <Button Content="Remove from list" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RemoveJobCommand}"
                                Visibility="{Binding IsFinished, Converter={StaticResource Show}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PauseExplanation}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Visibility="{Binding IsFinished, Converter={StaticResource Hide}}" />
                    <Border Height="18" />

                    <!-- Invoice -->
                    <Border Style="{StaticResource Section}"
                            Visibility="{Binding ShowInvoice, Converter={StaticResource Show}}">
                        <StackPanel>
                            <Grid>
                                <v:SectionTitle Text="Invoice" Glyph="&#xE8C7;" Hue="{StaticResource HuePink}" />
                                <Button Content="{Binding PrintInvoiceLabel}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,5" Margin="0,-4,0,0"
                                        Command="{Binding PrintInvoiceCommand}"
                                        Visibility="{Binding CanPrintInvoice, Converter={StaticResource Show}}" />
                            </Grid>
                            <TextBlock Text="{Binding InvoiceCharges}" Style="{StaticResource Mono}"
                                       Foreground="{StaticResource TextPrimary}" LineHeight="20" />
                            <TextBlock Text="{Binding InvoiceStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Batch history -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <v:SectionTitle Text="Batches" Glyph="&#xE81E;" Hue="{StaticResource HueAmber}" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding Batches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderBrush="{StaticResource Border}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="{Binding StatusForeground}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Heading}"
                                                               Style="{StaticResource Body}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Range}"
                                                               Style="{StaticResource Secondary}"
                                                               VerticalAlignment="Center" />

                                                    <Border Grid.Column="3" Style="{StaticResource Pill}"
                                                            Background="{Binding StatusBackground}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource PillText}"
                                                                   Foreground="{Binding StatusForeground}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"
                                                           Margin="28,5,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource Show}}" />

                                                <StackPanel Orientation="Horizontal" Margin="28,8,0,2"
                                                            Visibility="{Binding NeedsDecision, Converter={StaticResource Show}}">
                                                    <Button Content="These pages did print"
                                                            Style="{StaticResource SecondaryButton}" Padding="12,5"
                                                            Command="{Binding DataContext.ConfirmPrintedCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="They did not — send again"
                                                            Style="{StaticResource SecondaryButton}" Padding="12,5"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ConfirmNotPrintedCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource PrimaryButton}" Padding="12,5"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding CanResumeFrom, Converter={StaticResource Show}}"
                                                            Command="{Binding DataContext.ResumeFromCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock>
                                                            <Run Text="Keep the" />
                                                            <Run Text="{Binding ConfirmedPages, Mode=OneWay}" />
                                                            <Run Text="that printed, send the rest" />
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Activity -->
                    <Border Style="{StaticResource Section}" BorderThickness="0" Padding="0,16,0,10">
                        <StackPanel>
                            <Grid>
                                <v:SectionTitle Text="Activity" Glyph="&#xE81C;" Hue="{StaticResource HueSlate}" />
                                <Button Content="Export log…" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-8,0"
                                        Command="{Binding ExportLogCommand}" />
                            </Grid>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          x:Name="ActivityScroller">
                                <ItemsControl ItemsSource="{Binding RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </Grid>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="20,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding PrinterStatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PrinterStatus}" Style="{StaticResource Hint}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeviceStatus}" Style="{StaticResource Hint}"
                               Margin="16,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasDeviceStatus, Converter={StaticResource Show}}" />
                </StackPanel>

                <TextBlock Text="Closing this window keeps the queue running in the notification area."
                           Style="{StaticResource Hint}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
