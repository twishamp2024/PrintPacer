<Window x:Class="PrintPacer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPacer settings" Height="720" Width="640"
        MinHeight="520" MinWidth="560"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="22,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="These defaults apply to new jobs. A job that is already running keeps the settings it started with."
                           Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,0,0,14" />

                <!-- Overnight behaviour -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OVERNIGHT" Style="{StaticResource FieldLabel}" />

                        <CheckBox x:Name="KeepAwake" Style="{StaticResource Check}"
                                  Content="Keep the computer awake while a job is running" />
                        <TextBlock Text="Uses the Windows power-request API. The display is still allowed to switch off, so you can close the lid."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,0,0,10" />

                        <CheckBox x:Name="AutoResume" Style="{StaticResource Check}"
                                  Content="Continue unfinished jobs automatically when PrintPacer starts" />
                        <TextBlock Text="Only applies to jobs whose interrupted batches could be resolved with certainty. Anything in doubt always waits for you."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,0,0,10" />

                        <CheckBox x:Name="StartWithWindows" Style="{StaticResource Check}"
                                  Content="Start PrintPacer when I sign in to Windows" />
                        <CheckBox x:Name="StartMinimised" Style="{StaticResource Check}"
                                  Content="Start minimised to the notification area" />
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="NotificationsEnabled" Style="{StaticResource Check}"
                                  Content="Show notifications" />
                        <CheckBox x:Name="NotifyBatch" Style="{StaticResource Check}" Margin="26,4"
                                  Content="When a batch finishes, and when the next one is scheduled" />
                        <CheckBox x:Name="NotifyProblem" Style="{StaticResource Check}" Margin="26,4"
                                  Content="When the printer needs attention" />
                        <CheckBox x:Name="NotifyJob" Style="{StaticResource Check}" Margin="26,4"
                                  Content="When the whole document has printed" />
                    </StackPanel>
                </Border>

                <!-- Printing -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="PRINTING" Style="{StaticResource FieldLabel}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Render resolution"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="RenderDpi" Style="{StaticResource Dropdown}" Width="130">
                                    <ComboBoxItem Content="150 dpi (fastest)" Tag="150" />
                                    <ComboBoxItem Content="200 dpi" Tag="200" />
                                    <ComboBoxItem Content="300 dpi (default)" Tag="300" />
                                    <ComboBoxItem Content="400 dpi" Tag="400" />
                                    <ComboBoxItem Content="600 dpi (slowest)" Tag="600" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Higher resolutions take noticeably longer to prepare each page and use much more memory. 300 dpi matches what an inkjet actually puts on plain paper."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,4" />

                        <CheckBox x:Name="Grayscale" Style="{StaticResource Check}"
                                  Content="Render in greyscale" />
                    </StackPanel>
                </Border>

                <!-- Reliability -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="WHEN SOMETHING GOES WRONG" Style="{StaticResource FieldLabel}" />

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Re-check the printer every"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="RetryInterval" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="minutes" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Give up waiting after"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="BlockedGiveUp" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="minutes (0 = never give up)"
                                       Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Treat a batch as stalled after"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="StallTimeout" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="minutes without progress"
                                       Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Automatic retries per batch"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="MaxRetries" Style="{StaticResource Field}" Height="32" />
                        </Grid>

                        <TextBlock Text="A batch is only ever resent automatically when the evidence shows that nothing printed. If the outcome is uncertain, PrintPacer always stops and asks you, no matter what these numbers say."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Printer status source -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="READING THE PRINTER DIRECTLY" Style="{StaticResource FieldLabel}" />

                        <CheckBox x:Name="DeviceProbeEnabled" Style="{StaticResource Check}"
                                  Content="Ask the printer about its own status over the network" />
                        <TextBlock Text="Network printers can report their real state and their physical page counter. That counter is what lets PrintPacer tell, after a crash, whether pages actually came out. Without it, interrupted batches have to be confirmed by hand."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,0,0,10" />

                        <Grid Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Address (optional)"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="DeviceAddress" Style="{StaticResource Field}" Height="32" />
                        </Grid>
                        <TextBlock Text="Leave blank to find the printer automatically."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,10">
                    <StackPanel>
                        <TextBlock Text="STORAGE" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Keep logs for"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="LogRetention" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="days" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="DataLocation" Style="{StaticResource Secondary}"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <Button Content="Open the data folder" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left" Margin="-8,4,0,0" Click="OnOpenDataFolder" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock x:Name="ValidationMessage" Style="{StaticResource Body}"
                           Foreground="{StaticResource Danger}" FontSize="12.5"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancel" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
