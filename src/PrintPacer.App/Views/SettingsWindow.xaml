<Window x:Class="PrintPacer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PrintPacer.App.Views"
        Title="PrintPacer settings" Height="780" Width="680"
        MinHeight="520" MinWidth="560"
        Background="{DynamicResource Page}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="24,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Every PDF you add becomes its own job, starting from the defaults below. After that each job keeps its own settings: changing a job never changes these, and changing these never changes a job already in the list."
                           Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,0,0,14" TextWrapping="Wrap" />

                <!-- Defaults for new jobs -->
                <Border Style="{StaticResource Section}" BorderThickness="0" Padding="0,0,0,16">
                    <StackPanel>
                        <v:SectionTitle Text="Defaults for new jobs" Glyph="&#xE7C3;" Hue="{DynamicResource HueViolet}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Printer" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DefaultPrinter" Style="{StaticResource Dropdown}"
                                      Margin="0,0,0,8" AutomationProperties.Name="Default printer" />

                            <TextBlock Grid.Row="1" Text="Print mode" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DefaultColour" Style="{StaticResource Dropdown}"
                                      Width="220" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Default print mode">
                                <ComboBoxItem Content="Colour" Tag="Colour" />
                                <ComboBoxItem Content="Black &amp; white" Tag="BlackAndWhite" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Sides" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DefaultSides" Style="{StaticResource Dropdown}"
                                      Width="300" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Default sides">
                                <ComboBoxItem Content="Single-sided" Tag="SingleSided" />
                                <ComboBoxItem Content="Double-sided, flip on long edge" Tag="LongEdge" />
                                <ComboBoxItem Content="Double-sided, flip on short edge" Tag="ShortEdge" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="Batch size" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="DefaultPagesPerBatch" Style="{StaticResource Field}" Width="80" Height="34"
                                         AutomationProperties.Name="Default pages per batch" />
                                <TextBlock Text="pages (sheets when double-sided)" Style="{StaticResource Secondary}" FontSize="12"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="Rest between batches" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="DefaultDelay" Style="{StaticResource Field}" Width="80" Height="34"
                                         AutomationProperties.Name="Default rest in minutes" />
                                <TextBlock Text="minutes" Style="{StaticResource Secondary}" FontSize="12"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="DefaultInvoice" Style="{StaticResource Check}" Margin="0,12,0,4"
                                  Content="Print an invoice when each job finishes" />
                        <StackPanel Orientation="Horizontal" Margin="26,4,0,0">
                            <TextBlock Text="Black &amp; white page" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox x:Name="DefaultBlackWhitePrice" Style="{StaticResource Field}" Width="80" Height="32" Margin="8,0,0,0"
                                     AutomationProperties.Name="Default price per black and white page" />
                            <TextBlock Text="Colour page" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0" />
                            <TextBox x:Name="DefaultColourPrice" Style="{StaticResource Field}" Width="80" Height="32" Margin="8,0,0,0"
                                     AutomationProperties.Name="Default price per colour page" />
                        </StackPanel>
                        <TextBlock Text="Page selection and layout always start at all pages, normal. Render resolution is under Printing below. A job's own settings screen also has “Use as defaults”."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Overnight behaviour -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <v:SectionTitle Text="Overnight" Glyph="&#xE708;" Hue="{DynamicResource HueIndigo}" />

                        <CheckBox x:Name="KeepAwake" Style="{StaticResource Check}"
                                  Content="Keep the computer awake while a job is running" />
                        <TextBlock Text="Uses the Windows power-request API. The display is still allowed to switch off, so you can close the lid."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,0,0,10" />

                        <CheckBox x:Name="AutoResume" Style="{StaticResource Check}"
                                  Content="Continue unfinished jobs automatically when PrintPacer starts" />
                        <TextBlock Text="Only applies to jobs whose interrupted batches could be resolved with certainty. Anything in doubt always waits for you."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,0,0,10" />

                        <CheckBox x:Name="ContinueQueue" Style="{StaticResource Check}"
                                  Content="When a job needs my decision, carry on with the next job in the queue" />
                        <TextBlock Text="The job that needs you keeps its place and every unprinted batch, and nothing of it is sent again until you decide. The queue only moves on when none of that job's pages can still be in the Windows print queue. A paused job always holds the queue."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,0,0,10" TextWrapping="Wrap" />

                        <CheckBox x:Name="StartWithWindows" Style="{StaticResource Check}"
                                  Content="Start PrintPacer when I sign in to Windows" />
                        <CheckBox x:Name="StartMinimised" Style="{StaticResource Check}"
                                  Content="Start minimised to the notification area" />
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <v:SectionTitle Text="Notifications" Glyph="&#xE7E7;" Hue="{DynamicResource HueAmber}" />
                        <CheckBox x:Name="NotificationsEnabled" Style="{StaticResource Check}"
                                  Content="Show notifications" />
                        <CheckBox x:Name="NotifyBatch" Style="{StaticResource Check}" Margin="26,4"
                                  Content="When a batch finishes, and when the next one is scheduled" />
                        <CheckBox x:Name="NotifyProblem" Style="{StaticResource Check}" Margin="26,4"
                                  Content="When the printer needs attention" />
                        <CheckBox x:Name="NotifyJob" Style="{StaticResource Check}" Margin="26,4"
                                  Content="When the whole document has printed" />
                    </StackPanel>
                </Border>

                <!-- Printing -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <v:SectionTitle Text="Printing" Glyph="&#xE749;" Hue="{DynamicResource HueTeal}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Render resolution"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="RenderDpi" Style="{StaticResource Dropdown}" Width="180">
                                    <ComboBoxItem Content="150 dpi (fastest)" Tag="150" />
                                    <ComboBoxItem Content="200 dpi" Tag="200" />
                                    <ComboBoxItem Content="300 dpi (default)" Tag="300" />
                                    <ComboBoxItem Content="400 dpi" Tag="400" />
                                    <ComboBoxItem Content="600 dpi (slowest)" Tag="600" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Higher resolutions take noticeably longer to prepare each page and use much more memory. 300 dpi matches what an inkjet actually puts on plain paper."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,4" />
                    </StackPanel>
                </Border>

                <!-- Reliability -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <v:SectionTitle Text="When something goes wrong" Glyph="&#xE7BA;" Hue="{DynamicResource HueRed}" />

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Re-check the printer every"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="RetryInterval" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="minutes" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Give up waiting after"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="BlockedGiveUp" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="minutes (0 = never give up)"
                                       Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Treat a batch as stalled after"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="StallTimeout" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="minutes without progress"
                                       Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Automatic retries per batch"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="MaxRetries" Style="{StaticResource Field}" Height="32" />
                        </Grid>

                        <TextBlock Text="A batch is only ever resent automatically when the evidence shows that nothing printed. If the outcome is uncertain, PrintPacer always stops and asks you, no matter what these numbers say."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Printer status source -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <v:SectionTitle Text="Reading the printer directly" Glyph="&#xE9D9;" Hue="{DynamicResource HueBlue}" />

                        <CheckBox x:Name="DeviceProbeEnabled" Style="{StaticResource Check}"
                                  Content="Ask the printer about its own status over the network" />
                        <TextBlock Text="Network printers can report their real state and their physical page counter. That counter is what lets PrintPacer tell, after a crash, whether pages actually came out. Without it, interrupted batches have to be confirmed by hand."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,0,0,10" />

                        <Grid Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Address (optional)"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="DeviceAddress" Style="{StaticResource Field}" Height="32" />
                        </Grid>
                        <TextBlock Text="Leave blank to find the printer automatically."
                                   Style="{StaticResource Secondary}" FontSize="12" Margin="26,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <v:SectionTitle Text="Storage" Glyph="&#xE8B7;" Hue="{DynamicResource HueGreen}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Keep logs for"
                                       Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="LogRetention" Style="{StaticResource Field}" Height="32" />
                            <TextBlock Grid.Column="2" Text="days" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Jobs, settings and logs"
                                       Style="{StaticResource Body}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" x:Name="DataFolderPath" Style="{StaticResource Body}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock x:Name="DataFolderMove" Style="{StaticResource Body}" FontSize="12.5"
                                   Foreground="{DynamicResource Accent}" Margin="220,4,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="212,2,0,0">
                            <Button Content="Open" Style="{StaticResource LinkButton}" Click="OnOpenDataFolder" />
                            <Button x:Name="ChangeDataFolderButton" Content="Change…" Style="{StaticResource LinkButton}"
                                    Click="OnChangeDataFolder" />
                            <Button x:Name="KeepDataFolderButton" Content="Don't move" Style="{StaticResource LinkButton}"
                                    Click="OnKeepDataFolder" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="DataLocation" Style="{StaticResource Secondary}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock x:Name="ValidationMessage" Style="{StaticResource Body}"
                           Foreground="{DynamicResource Danger}" FontSize="12.5"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancel" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
